{
  "name": "FormatjsHermes",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "vrt": "node vrt/compare.mjs",
    "typecheck": "tsc --noEmit",
    "ios": "react-native run-ios",
    "test:ios": "bash .github/scripts/ios-e2e.sh"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.formatjshermes.specs"
    },
    "ios": {
      "modulesProvider": {
        "NativeIntlModule": "NativeIntlModuleProvider"
      }
    }
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/react": "^19.2.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "^6.0.3",
    "@react-native-community/cli-platform-ios": "20.2.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
